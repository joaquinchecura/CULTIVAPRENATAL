{
  "compilerOptions": {
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [],
    "ignoreDeprecations": "5.0" 
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}